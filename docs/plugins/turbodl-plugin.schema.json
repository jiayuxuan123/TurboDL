{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://turbodl.dev/schemas/turbodl-plugin.schema.json",
  "title": "TurboDL Plugin Manifest",
  "description": "Machine-readable descriptor placed at the root of a TurboDL plugin repository.",
  "type": "object",
  "required": ["manifestVersion", "id", "name", "version", "category", "turbodl", "entry"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": {
      "type": "string",
      "description": "Manifest schema version.",
      "enum": ["1.0"]
    },
    "id": {
      "type": "string",
      "description": "Must equal the plugin's Plugin.id. Lowercase, dot-separated <category>.<name>.",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "description": "Plugin release version (semantic).",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+].*)?$"
    },
    "author": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "turbodl-backend",
        "turbodl-adapter",
        "turbodl-parser",
        "turbodl-hook",
        "turbodl-loader"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^turbodl-[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "turbodl": {
      "type": "object",
      "required": ["apiMajor", "requiredApiVersion"],
      "additionalProperties": false,
      "properties": {
        "apiMajor": { "type": "integer", "minimum": 1 },
        "requiredApiVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["language", "pluginClass"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "description": "kotlin today. js is reserved for a future JS provider.",
          "enum": ["kotlin", "js"]
        },
        "pluginClass": {
          "type": "string",
          "description": "Fully-qualified Plugin implementation class (kotlin), or script entry (js)."
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["maven", "jar"] },
        "coordinates": {
          "type": "string",
          "description": "Maven coordinates when type=maven, e.g. group:artifact:version."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Direct artifact URL when type=jar."
        }
      }
    },
    "extensionPoints": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Extension-point ids this plugin registers, e.g. turbo.downloadBackend."
    },
    "services": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Service ids this plugin publishes."
    }
  }
}
